# Copy to .env.local and fill in from the Vercel dashboard:
#   Project → Settings → Environment Variables
# or from Supabase → Project Settings → API.
#
# Anything prefixed VITE_ is bundled into the browser build and is therefore
# public. The Supabase anon key is designed for that; your row-level security
# policies are what actually protect the data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (used by /api routes on Vercel, never sent to the browser).
# Not needed for local UI work unless you're testing those endpoints.
# STRIPE_SECRET_KEY=
# RESEND_API_KEY=
# GOOGLE_CALENDAR_ID=
